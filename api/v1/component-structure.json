{
  "schemaVersion": "1.0",
  "reference": "https://reui.io/docs",
  "recipes": [
    {
      "id": "form",
      "title": "검증이 있는 업무 폼",
      "description": "입력부터 오류 수정, 제출 결과까지 하나의 흐름으로 구성합니다.",
      "components": [
        "field",
        "input",
        "select",
        "textarea",
        "button",
        "alert"
      ],
      "block": "form-incident-report",
      "steps": [
        "Field로 레이블·입력·도움말을 연결합니다.",
        "필수 조건과 오류 메시지를 입력 옆에 유지합니다.",
        "제출 중 중복 실행을 막고 결과를 알립니다."
      ]
    },
    {
      "id": "data",
      "title": "검색과 선택이 있는 데이터 화면",
      "description": "검색 조건, 결과, 일괄 작업을 분리해 많은 정보를 다룹니다.",
      "components": [
        "search-input",
        "data-grid",
        "checkbox",
        "pagination",
        "empty-state"
      ],
      "block": "support-tickets",
      "steps": [
        "검색 조건을 표 위에 두고 초기화 경로를 제공합니다.",
        "행 선택과 전체 선택의 범위를 표시합니다.",
        "검색 결과 없음과 데이터 없음, 오류를 구분합니다."
      ]
    },
    {
      "id": "dashboard",
      "title": "운영 현황 대시보드",
      "description": "요약 지표에서 추이와 상세 데이터로 내려갑니다.",
      "components": [
        "card",
        "statistic",
        "line-chart",
        "badge",
        "table"
      ],
      "block": "dashboard-sre-observability",
      "steps": [
        "수치에 기간과 단위를 함께 표시합니다.",
        "추이는 색과 범례를 함께 제공합니다.",
        "상세 표로 이동할 수 있는 행동을 명시합니다."
      ]
    },
    {
      "id": "permissions",
      "title": "팀 권한과 설정",
      "description": "설정값과 저장 행동을 구분하고 위험 변경을 확인합니다.",
      "components": [
        "tabs",
        "switch",
        "radio-group",
        "select",
        "alert-dialog"
      ],
      "block": "settings-team-permissions",
      "steps": [
        "주제별 탭으로 설정을 묶습니다.",
        "즉시 적용과 저장 후 적용을 명확히 안내합니다.",
        "위험한 변경은 영향 범위를 보여준 뒤 확인합니다."
      ]
    },
    {
      "id": "files",
      "title": "파일 가져오기",
      "description": "선택, 검토, 진행, 결과의 순서를 드러냅니다.",
      "components": [
        "dialog",
        "dropzone",
        "file-upload",
        "progress",
        "result"
      ],
      "block": "dialog-bulk-import-csv",
      "steps": [
        "지원 형식과 크기를 선택 전에 안내합니다.",
        "선택한 파일과 취소 행동을 제공합니다.",
        "진행률과 실패 이유, 재시도 경로를 분리합니다."
      ]
    },
    {
      "id": "activity",
      "title": "알림과 활동 이력",
      "description": "짧은 알림을 지속적으로 확인할 수 있는 목록으로 연결합니다.",
      "components": [
        "list",
        "avatar",
        "badge",
        "notification",
        "timeline"
      ],
      "block": "list-notification-inbox",
      "steps": [
        "발생 시각과 행동 주체를 표시합니다.",
        "읽음 상태를 텍스트나 아이콘으로 구분합니다.",
        "알림에서 관련 작업으로 이동할 수 있게 합니다."
      ]
    }
  ],
