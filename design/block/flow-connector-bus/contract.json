{"delivery":{"type":"reference-library","npmPackagePublished":false,"npmPackage":{"name":"klic-interface-library","version":"0.0.1","published":false,"status":"source-ready","registry":"https://registry.npmjs.org/","runtime":"Node.js 22+ or Bun 1.4.2","exports":["tokens","theme","CSS","TypeScript","CLI"],"buildCommand":"bun run pack:npm"},"scope":"/about","licenses":"/licenses/README.md"},"system":{"schemaVersion":"1.0","revision":"ed3d6f98ee9de632d172e6d76605b692fb839bbbadb5ef6e342bc3287d7553ef","definition":"/api/v1/design-system.json","docs":"/#docs/architecture"},"schemaVersion":"1.0","scope":"adoption-guidance","implementation":"react-demo","use":["「브로드캐스트 버스 백본」의 용도: 발행자 하나와 선택한 구독자들을 실제 공유 백본과 분기 접점으로 연결합니다. 구독자가 없는 상태를 구분합니다.","모든 구독자가 같은 발행 이벤트를 받는 브로드캐스트에 사용합니다."],"avoid":["좁은 화면을 이유로 수치·단위·범례를 생략하거나 폰트를 일괄 축소하지 않습니다.","샘플 데이터·로컬 상호작용을 실제 저장·인증·운영 기능으로 표시하지 않습니다.","임의의 개별 쌍 관계를 버스로 바꿔 존재하지 않는 연결을 암시하지 않습니다."],"accessibility":["Tab으로 연결선과 노드를 이동하고 Enter·Space로 선택합니다. 관계 표의 버튼으로도 같은 선택을 제공합니다.","조정값은 range의 방향키로 변경하고 초기화·SVG·JSON 내보내기를 키보드로 실행합니다.","모든 조작의 이름·보이는 초점·실제 target 경계를 확인한다. reduced-motion에서도 기능에 필요한 상태 안내를 유지한다.","2차원 다이어그램은 내부 가로 스크롤을 허용하고 관계 목록과 조정 컨트롤은 좁은 폭에서도 접근 가능하게 유지합니다.","CSS viewport·실제 콘텐츠 컨테이너·사용자 확대·명시적 density를 별개의 시험 조건으로 기록한다."],"density":{"compact":"데이터 비교·반복 행에 사용하며 셀 padding만 줄입니다. 글자 크기와 단위는 유지합니다.","normal":"기본 권장 밀도입니다. 읽기 순서와 레이블·컨트롤·피드백 그룹을 유지합니다.","relaxed":"설명 중심·프레젠테이션 화면에 사용합니다. 정보 계층을 유지하며 여백을 늘립니다."},"states":[{"name":"데이터 생명주기","condition":"조합 정책","response":"선택·선택 해제·조정값 변경·초기화·차단으로 인한 경로 없음·구독자 없음을 구분합니다."},{"name":"완료·선택","condition":"조합 정책","response":"완료·성공은 블루와 체크·명시적 문구로 전달한다. hover가 selected·invalid·focus 의미를 지우지 않도록 한다."}],"recovery":{"loading":"진행 중임을 알리고 중복 요청을 차단합니다. 기존 데이터가 있으면 갱신 중에도 유지합니다.","empty":"처음부터 데이터가 없는 상태에는 생성·연결 행동을 제공합니다.","filtered":"검색 결과가 없으면 데이터 없음과 구분하고 필터 초기화 행동을 제공합니다.","error":"마지막 정상 데이터를 보존하고 실패 영역에 재시도를 제공합니다."},"tokenMapping":[{"path":"klic.component.block.color.surface","purpos